/* Общий фон и стиль окна */
QWidget {
    background-color: #2b2b2b;
    color: #dcdcdc;
}

/* QLineEdit */
QLineEdit {
    border: 2px solid #4a4a4a;
    border-radius: 10px;
    padding: 8px;
    font-size: 16px;
    background-color: #2b2b2b;
    color: #dcdcdc;
}

QLineEdit:focus {
    border-color: #9a9edb;
    background-color: #3a3a3a;
}

/* QComboBox */
QComboBox {
    border: 2px solid #4a4a4a;
    border-radius: 10px;
    padding: 8px;
    font-size: 16px;
    background-color: #2b2b2b;
    color: #dcdcdc;
}

QComboBox:hover {
    border-color: #6a6a6a;
}

QComboBox:focus {
    border-color: #9a9edb;
    background-color: #3a3a3a;
}

QComboBox::drop-down {
    border: none;
    background-color: transparent;
}

QComboBox::down-arrow {
    image: url(res/arrow_down.png);
    width: 12px;
    height: 12px;
}

/* QPushButton */
QPushButton {
    border: 2px solid #4a4a4a;
    border-radius: 10px;
    padding: 8px;
    background-color: #2b2b2b;
    color: #dcdcdc;
}

QPushButton:hover {
    background-color: #3a3a3a;
}
