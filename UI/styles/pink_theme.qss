/* Общий фон и стиль окна */
QWidget, QStackedWidget, QTabWidget::pane, QScrollArea, QListWidget {
    background-color: #fbe7ef;
    color: #4a4a4a;
    font-size: 16px;
}

/* QLineEdit */
QLineEdit {
    border: 2px solid #e1b5c2;
    border-radius: 10px;
    padding: 8px;
    background-color: #f7dce5;
    color: #4a4a4a;
}
QLineEdit:focus, QLineEdit:hover {
    border-color: #d28da7;
    background-color: #f1d1db;
}

/* QComboBox */
QComboBox {
    background-color: #fce4ec;
    color: #5a5a5a;
    border: 2px solid #e5a2bd;
    border-radius: 10px;
    padding: 8px 30px 8px 8px;
    font-size: 16px;
}

QComboBox:hover {
    border-color: #d890a9;
}

QComboBox:focus {
    border-color: #ff99cc;
    background-color: #ffebf5;
}

/* Стрелка и меню в розовой теме */
QComboBox::down-arrow {
    image: url(res/arrow_down.png);
    width: 12px;
    height: 12px;
    margin-right: 8px;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
    background: transparent;
}

QComboBox QAbstractItemView {
    background-color: #fce4ec;
    color: #5a5a5a;
    selection-background-color: #ff99cc;
    border: 1px solid #e5a2bd;
}


/* QPushButton */
QPushButton {
    border: 2px solid #e1b5c2;
    border-radius: 10px;
    padding: 8px;
    background-color: #f7dce5;
    color: #4a4a4a;
}
QPushButton:hover {
    background-color: #e9c6d1;
    border-color: #d28da7;
}
QPushButton:pressed {
    background-color: #d7a9b8;
}

/* QTabWidget и вкладки */
QTabWidget::pane {
    border: 2px solid #e1b5c2;
    background-color: #f7dce5;
}
QTabBar::tab {
    background-color: #f7dce5;
    border: 2px solid #e1b5c2;
    padding: 6px;
    margin: 2px;
    color: #4a4a4a;
    font-size: 14px;
}
QTabBar::tab:selected {
    background-color: #f1d1db;
    color: #4a4a4a;
}

/* QScrollArea */
QScrollArea {
    border: 2px solid #e1b5c2;
}

/* QListWidget */
QListWidget {
    border: 2px solid #e1b5c2;
    background-color: #f7dce5;
    color: #4a4a4a;
}
QListWidget::item:selected {
    background-color: #e3b1be;
    color: #4a4a4a;
}
